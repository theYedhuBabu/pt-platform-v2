# Local environment. Copied from .env.example — fill with real values.
# NOTE: the Go hub reads OS env vars directly and does NOT auto-load this file;
# `export $(grep -v '^#' .env | xargs)` (or your process manager) for the backend.
# Vite DOES read this file (envDir points here) but only exposes VITE_* keys to
# the frontend bundle — nothing else below is ever shipped to the browser.

# Hub server
HUB_PORT=:8080
HUB_HOST=http://localhost:8080
DB_PATH=internal/database/data/hub.db
CORS_ALLOWED_ORIGIN=http://localhost:5173
SCRIPTS_DIR=data/scripts

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin123

# Grafana (hub backend) — runtime, builds the /api/history deep-link
GRAFANA_BASE_URL=http://localhost:3000
GRAFANA_RUN_DASHBOARD_UID=jmeter-clickhouse-v1/jmeter-performance-dashboard

# Grafana (frontend) — BUILD-TIME; baked in by `npm run build`. Replace the UID
# and panel IDs with your dashboard's real values, then rebuild the frontend.
# Relative path → resolves against whatever host serves the app (localhost:8080
# OR the ngrok URL), routed by the hub's /grafana reverse proxy. Rebuild after
# changing: `npm run build`. (Vite dev server proxies /grafana — see vite.config.)
VITE_GRAFANA_BASE_URL=/grafana
VITE_GRAFANA_RUN_DASHBOARD_UID=jmeter-clickhouse-v1
VITE_GRAFANA_PANEL_THROUGHPUT=4
VITE_GRAFANA_PANEL_THREADS=311
VITE_GRAFANA_PANEL_ERRORS=5
VITE_GRAFANA_GRANULARITY=10
VITE_GRAFANA_TIME_FROM=now-15m
