# Hub server
HUB_PORT=:8080
HUB_HOST=http://localhost:8080
DB_PATH=internal/database/data/hub.db
CORS_ALLOWED_ORIGIN=http://localhost:5173
SCRIPTS_DIR=data/scripts

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin123

# Grafana (hub backend) — runtime vars read by hub-server.
# Only used to build the per-run dashboard deep-link in /api/history.
GRAFANA_BASE_URL=http://localhost:3000
GRAFANA_RUN_DASHBOARD_UID=jmeter-clickhouse-v1/jmeter-performance-dashboard

# Grafana (frontend) — BUILD-TIME vars baked into the JS bundle by Vite.
# Drive the embedded <iframe> panels on the RunLive page. These are read via
# import.meta.env at build time, so they must be set BEFORE `npm run build`
# (setting them on the running hub-server has no effect). Separate from the
# backend GRAFANA_* vars above. Leave unset to show "Grafana not configured".
# Embedding also requires Grafana-side config: allow_embedding=true and a way
# to view panels without an interactive login (e.g. anonymous auth).
# UID is the bare dashboard UID (no /slug) for d-solo embeds. Panel IDs are the
# numeric `id` of each panel in the dashboard JSON (the N in ?viewPanel=panel-N).
VITE_GRAFANA_BASE_URL=http://localhost:3000
VITE_GRAFANA_RUN_DASHBOARD_UID=jmeter-clickhouse-v1
VITE_GRAFANA_PANEL_THROUGHPUT=4
VITE_GRAFANA_PANEL_THREADS=311
VITE_GRAFANA_PANEL_ERRORS=5
# granularity (seconds) is interpolated straight into the dashboard SQL — required.
VITE_GRAFANA_GRANULARITY=10
VITE_GRAFANA_TIME_FROM=now-15m

# ─────────────────────────────────────────────────────────────────────────────
# Single-port / ngrok reverse proxy
# ─────────────────────────────────────────────────────────────────────────────
# The hub reverse-proxies Grafana and ClickHouse under its own origin so ONE
# tunnel (ngrok free tier = one port) can front everything:
#   {hub}/grafana    → GRAFANA_BASE_URL    (prefix preserved)
#   {hub}/clickhouse → CLICKHOUSE_URL      (prefix stripped — CH serves at "/")
# GRAFANA_BASE_URL / CLICKHOUSE_URL above stay pointing at the LOCAL services
# (localhost:3000 / :8123) — those are the proxy *upstreams*, not public URLs.
#
# To expose externally:  ngrok http 8080   then open https://<id>.ngrok-app/
#
# 1. Grafana must serve from the sub-path (otherwise its redirects/assets 404).
#    Set on the Grafana process (env or grafana.ini):
#       GF_SERVER_ROOT_URL=https://<id>.ngrok-app/grafana/
#       GF_SERVER_SERVE_FROM_SUB_PATH=true
#       GF_SECURITY_ALLOW_EMBEDDING=true   # for the RunLive <iframe> panels
#
# 2. Point the frontend iframes at the proxy path (relative → resolves against
#    whatever host the browser loaded, incl. the ngrok URL), then `npm run build`:
#       VITE_GRAFANA_BASE_URL=/grafana
#
# 3. (Optional) the /api/history deep-link is browser-opened, so a relative
#    value works there too:
#       GRAFANA_BASE_URL=/grafana       # note: also becomes the proxy upstream,
#    so only do this if Grafana is reachable at a relative path from the hub —
#    normally keep GRAFANA_BASE_URL=http://localhost:3000 (upstream) and live
#    with absolute-localhost history links, or thread the public host separately.
#
# SECURITY: /clickhouse exposes the ClickHouse HTTP API through the tunnel.
# The proxy forwards requests as-is (no credential injection), but anyone with
# the ngrok URL can reach it. Grafana queries ClickHouse server-side over
# localhost, so you usually do NOT need /clickhouse public — drop CLICKHOUSE_URL
# handling or front it with auth if exposing to the internet.

